{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Logtower",
  "version": "0.0.1",
  "identifier": "com.charlie.logtower",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run start",
    "devUrl": "http://localhost:4200",
    "frontendDist": "../dist/logtower/browser"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Logtower",
        "width": 1000,
        "height": 600,
        "minWidth": 800,
        "minHeight": 555
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/logtower.png",
      "icons/logtower.png",
      "icons/logtower.png",
      "icons/icon.icns",
      "icons/logtower.ico"
    ]
  }
}
