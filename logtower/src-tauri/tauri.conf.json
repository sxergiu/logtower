{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Logtower",
  "version": "0.2.1",
  "identifier": "com.charlie.logtower",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run start",
    "devUrl": "http://localhost:4200",
    "frontendDist": "../dist/logtower/browser"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Logtower",
        "width": 1000,
        "height": 600,
        "minWidth": 800,
        "minHeight": 555
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/logtower.rgba",
      "icons/logtower.rgba",
      "icons/logtower.rgba",
      "icons/logtower-512.png",
      "icons/logtower.icns",
      "icons/logtower.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE5RkQ4MzFGRDNCQUMwQzEKUldUQndMclRINFA5cVF0bEdPOGozTFBuR1FycVZIK1NwREhCcGJvYnRvNHg4QkRvMS9zQ01oZTcK",
      "endpoints": [
        "https://github.com/sxergiu/logtower/releases/latest/download/latest.json"
      ]
    }
  }
}
